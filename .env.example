# Copy to .env for local development. Never commit secrets.
OPENAI_API_KEY=
OPENAI_CLINIC_MODEL=gpt-5-mini
OPENAI_CLINIC_REASONING_EFFORT=low
OPENAI_CLINIC_MAX_OUTPUT_TOKENS=2500
SIGNALAI_CLINIC_MAX_PAGES=5
SIGNALAI_CLINIC_MAX_BATCH=10
SIGNALAI_CLINIC_STALE_DAYS=30
# Configure a model explicitly when inference is implemented.
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_CHAIR_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_CHAIR_MAX_OUTPUT_TOKENS=6000
OPENAI_CHAIR_RETRY_MAX_OUTPUT_TOKENS=8000
# Product Design Lab uses one bounded hypothesis and review panel per run.
OPENAI_DESIGN_MODEL=gpt-5-mini
OPENAI_DESIGN_REASONING_EFFORT=low
OPENAI_DESIGN_CHAIR_REASONING_EFFORT=medium
OPENAI_DESIGN_MAX_OUTPUT_TOKENS=5000
OPENAI_DESIGN_CHAIR_MAX_OUTPUT_TOKENS=2500
OPENAI_DESIGN_RETRY_MAX_OUTPUT_TOKENS=6000
# Optional cost overrides for non-default models, in USD per 1M tokens:
# OPENAI_INPUT_COST_PER_MILLION=
# OPENAI_CACHED_INPUT_COST_PER_MILLION=
# OPENAI_OUTPUT_COST_PER_MILLION=
# Optional read-only source root for the explicit legacy JSON migration.
SIGNALAI_LEGACY_ROOT=/Users/raziel/Desktop/signalAgent
